;***************************************************************************************
; CONOUT BIOS FUNCTION
;***************************************************************************************

include "laser500.lm"

; TODO implement IOBYTE
; TODO implement REVERSE
; TODO implement BELL
; TODO implement cursor emulation ANSI, ESC codes

EXTERN CAPSLOCK       ; defined in CONIN.ASM

PUBLIC _CCOL          ; makes CCOL accessible from C
PUBLIC _CROW          ; makes CROW accessible from C
PUBLIC _CONOUT        ; makes CONOUT accessible from C

_CCOL   EQU CCOL      ; makes CCOL accessible from C
_CROW   EQU CROW      ; makes CROW accessible from C
_CONOUT EQU CONOUT    ; makes CONOUT accessible from C

CCOL: DEFB 0         ; initial column cursor position
CROW: DEFB 0         ; initial row cursor position

CONOUT:
    di
    call VBANK_ON
    call CURSOR_TOGGLE
    call HANDLE_CHARS
    call CURSOR_TOGGLE
    call VBANK_OFF
    ei
    ret

HANDLE_CHARS:
    ; special ASCII characters
    IF a=  6 THEN goto CHAR_CAPSLOCK
    IF a=  8 THEN goto CHAR_BACKSPACE
    IF a=  9 THEN goto CHAR_TAB
    IF a= 10 THEN goto CHAR_LF
    IF a= 12 THEN goto CHAR_FF
    IF a= 13 THEN goto CHAR_CR
   ;IF a=  7 THEN goto CHAR_BELL
    IF a= 14 THEN goto CHAR_RIGHT
    IF a= 15 THEN goto CHAR_UP
   ;IF a= 27 THEN goto CHAR_ESCAPE

NORMAL_CHARACTER:
    push af                ; save character in A
    call CALC_CURSOR_ADDR  ; HL = cursor address
    pop  af                ;
    ld   (hl),a            ; writes the character over the cursor (canceling it)
    call CURSOR_RIGHT      ; goes right
    ret

CHAR_CAPSLOCK:
    ld   a,(CAPSLOCK)
    cpl
    ld   (CAPSLOCK),a
    // TODO also toggle LED
    ret

CHAR_BACKSPACE:
    CALL  CURSOR_LEFT      ; move left
    ret

CHAR_RIGHT:
    CALL CURSOR_RIGHT
    ret

CHAR_UP:
    CALL CURSOR_UP
    ret

CHAR_TAB:
    CALL CURSOR_RIGHT
    ld   a,(CCOL)
    and  0x07               ; moves right until COL & 7 = 0
    ret  z
    jr   CHAR_TAB

CHAR_LF:
    CALL  CURSOR_DOWN
    ret

CHAR_CR:
    xor   a           ; column 1
    ld    (CCOL),a    ; sets cursor to column 1
    ret

CHAR_FF:
    ld hl,VIDEO
    ld de,VIDEO+1
    ld bc, 2031      ; video page size: FFA0+50-F800
    ld a,32          ; TODO consider reverse
    ld (hl),a
    ldir
    xor  a           ; a=0
    ld   (CCOL),a    ; go first col
    ld   (CROW),a    ; go first row
    ret

;
; calculates in HL the address in video memory of the cursor
; at position (CCOL, CROW)
;
CALC_CURSOR_ADDR:
    push de
    ld   a,(CROW)
    sla  a
    ld   l,a
    ld   h,0
    ld   de,ROWTABLE
    add  hl,de
    ld   e,(hl)
    inc  hl
    ld   d,(hl)
    push de
    pop  hl
    ld   d, 0
    ld   a,(CCOL)
    ld   e,a
    add  hl,de
    pop  de
    ret

;
; Purpose: reverse the character under the cursor
; at position (CCOL, CROW)
;
CURSOR_TOGGLE:
    push af
    call CALC_CURSOR_ADDR
    ld   a,(hl)
    xor  128
    ld   (hl),a
    pop  af
    ret

;
; Purpose: advances the cursor 1 position down
; updating (CCOL, CROW)
;
CURSOR_DOWN:
    ld a,(CROW)
    IF a=NROWS-1 THEN
       CALL SCROLL_UP
    ELSE
       inc a
       ld (CROW),a
    END IF
    ret

;
; Purpose: advances the cursor 1 position up
; updating (CCOL, CROW)
;
CURSOR_UP:
    ld a,(CROW)
    IF a=0 THEN ret
    dec a
    ld (CROW),a
    ret

;
; Purpose: advances the cursor 1 position to the right
; updating (CCOL, CROW)
;
CURSOR_RIGHT:
    ld a,(CCOL)
    IF a=NCOLS-1 THEN
       xor a
       ld (CCOL),a
       ld a,(CROW)
       IF a=NROWS-1 THEN
          CALL SCROLL_UP
       ELSE
          inc a
          ld (CROW),a
       END IF
    ELSE
       inc a
       ld (CCOL),a
    END IF
    ret

;
; Purpose: advances the cursor 1 position to the left
; updating (CCOL, CROW)
;
CURSOR_LEFT:
    ld a,(CCOL)
    dec a
    ld (CCOL),a
    IF a=-1 THEN
       ld a,NCOLS-1
       ld (CCOL),a
       ld a,(CROW)
       dec a
       ld (CROW),a
       IF a=-1 THEN
          xor a
          ld (CCOL),a
          ld (CROW),a
       END IF
    END IF
    ret

;
; Purpose: scrolls up the video by one row
;

counter:
    defb 0

SCROLL_UP:
    push bc
    push de
    push hl

    ; save current cursor pos
    ld a,(CCOL) : ld l,a
    ld a,(CROW) : ld h,a
    push hl

    ld a,0
    ld (counter),a
    ld (CCOL),a
    do
        ; DE = row[counter]
        ld a,(counter)
        ld (CROW),a
        call CALC_CURSOR_ADDR
        ld e,l
        ld d,h

        ; HL = row[counter + 1]
        ld a,(counter)
        inc a
        ld (CROW),a
        call CALC_CURSOR_ADDR

        ; BC = 80
        ld bc,80

        ; copy row
        ldir

        ; increment row
        ld   a,(counter)
        inc  a
        ld   (counter),a
    loop while a <> 23

    ld a,32       ; space char TODO consider reverse
    ld hl,32672   ; last row
    ld de,32672+1 ; last row, col 1
    ld (hl),a     ; write first space
    ld bc,80      ; repeat 80
    ldir          ; go

    ; restore current cursor pos
    pop hl
    ld a,l : ld (CCOL),a
    ld a,h : ld (CROW),a

    pop hl
    pop de
    pop bc
    ret

VBANK_ON:
    push af
    ld   a, VIDEO_PAGE
    out  (BANK1),a
    pop  af
    ret

VBANK_OFF:
    push af
    ld   a,ROM1_PAGE
    out  (BANK1),a
    pop  af
    ret

ROWTABLE:
    DEFW 30720
    DEFW 30976
    DEFW 31232
    DEFW 31488
    DEFW 31744
    DEFW 32000
    DEFW 32256
    DEFW 32512
    DEFW 30800
    DEFW 31056
    DEFW 31312
    DEFW 31568
    DEFW 31824
    DEFW 32080
    DEFW 32336
    DEFW 32592
    DEFW 30880
    DEFW 31136
    DEFW 31392
    DEFW 31648
    DEFW 31904
    DEFW 32160
    DEFW 32416
    DEFW 32672
