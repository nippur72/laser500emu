	255, 137, 136, 135, 134, 133, 132,   // UN F10 F9 F8 F7 F6 F5
	255, 128, 129, 130, 131, 255, 255    // UN F1 F2 F3 F4 UN UN
};

// control keymap
byte SCANCODES_CONTROL[84] = {
	255,  26,  24,   3,  22,   2,  14,	// SHIFT z x c v b n
	255,   1,  19,   4,   6,   7,   8,	// SHIFT a s d f g h
	'\t', 17,  23,   5,   18,  20, 25,  // TAB q w e r t y
	 27, '1', '2', '3', '4', '5', '6',	// ESC 1 2 3 4 5 6
	255, '=', '-', '0', '9', '8', '7',	// UN = - 0 9 8 7
	  8, 255, 255,  16,  15,   9,  21,	// BS UN UN p o i u
	 13, 255,  39,  58,  12,  11,  10,	// RET UN ' colon l k j
	255, '`', ' ', '/', '.', ',',  13,	// GRAPH ` SP \ . , m
	255,'\\', ']', '[', '~', 127, 141,	// UN \ [ ] ~ DEL INS
	  6, 138, 139,  15,   8,  14,  10,	// CAPS DELLINE HOME UP LEFT RIGHT DOWN
	255, 137, 136, 135, 134, 133, 132,	// UN F10 F9 F8 F7 F6 F5
	255, 128, 129, 130, 131, 255, 255	// UN F1 F2 F3 F4 UN UN
};
*/

PUBLIC _SCANCODES_NORMAL
PUBLIC _SCANCODES_SHIFT
PUBLIC _SCANCODES_CONTROL

_SCANCODES_NORMAL   EQU SCANCODES_NORMAL
_SCANCODES_SHIFT    EQU SCANCODES_SHIFT
_SCANCODES_CONTROL  EQU SCANCODES_CONTROL

// unshifted keymap
SCANCODES_NORMAL:
	db	255, 'z', 'x', 'c', 'v', 'b', 'n'    // SHIFT z x c v b n
	db	255, 'a', 's', 'd', 'f', 'g', 'h'    // CTRL a s d f g h
	db	'\t','q', 'w', 'e', 'r', 't', 'y'    // TAB q w e r t y
	db	 27, '1', '2', '3', '4', '5', '6'    // ESC 1 2 3 4 5 6
	db	255, '=', '-', '0', '9', '8', '7'    // UN = - 0 9 8 7
	db	  8, 255, 255, 'p', 'o', 'i', 'u'    // BS UN UN p o i u
	db	 13, 255,  39,  58, 'l', 'k', 'j'    // RET UN ' colon l k j
	db	255, '`', ' ', '/', '.', ',', 'm'    // GRAPH ` SP \ . , m
	db	255,'\\', ']', '[', '~', 127, 141    // UN \ [ ] ~ DEL INS
	db	  6, 138, 139,  15,   8,  14,  10    // CAPS DELLINE HOME UP LEFT RIGHT DOWN
	db	255, 137, 136, 135, 134, 133, 132    // UN F10 F9 F8 F7 F6 F5
	db	255, 128, 129, 130, 131, 255, 255    // UN F1 F2 F3 F4 UN UN

// shifted keymap
SCANCODES_SHIFT:
	db 255, 'Z', 'X', 'C', 'V', 'B', 'N'    // SHIFT z x c v b n
	db 255, 'A', 'S', 'D', 'F', 'G', 'H'    // SHIFT a s d f g h
   db '\t','Q', 'W', 'E', 'R', 'T', 'Y'    // TAB q w e r t y
	db  27, '!', '@', '#', '$', '%', '^'    // ESC 1 2 3 4 5 6
	db 255, '+', '_', ')', '(', '*', '&'    // UN = - 0 9 8 7
	db   8, 255, 255, 'P', 'O', 'I', 'U'    // BS UN UN p o i u
	db  13, 255,  34,  59, 'L', 'K', 'J'    // RET UN ' colon l k j
	db 255, '`', ' ', '?', '>', '<', 'M'    // GRAPH \ SP \ . , m
	db 255,'\\', '}', '{', '~', 127, 141    // UN \ [ ] ~ DEL INS
	db   6, 138,  12,  15,   8,  14,  10    // CAPS DELLINE HOME UP LEFT RIGHT DOWN
	db 255, 137, 136, 135, 134, 133, 132    // UN F10 F9 F8 F7 F6 F5
	db 255, 128, 129, 130, 131, 255, 255    // UN F1 F2 F3 F4 UN UN

// control keymap
SCANCODES_CONTROL:
	db 255,  26,  24,   3,  22,   2,  14 	// SHIFT z x c v b n
	db 255,   1,  19,   4,   6,   7,   8 	// SHIFT a s d f g h
	db '\t', 17,  23,   5,   18,  20, 25   // TAB q w e r t y
	db  27, '1', '2', '3', '4', '5', '6' 	// ESC 1 2 3 4 5 6
	db 255, '=', '-', '0', '9', '8', '7' 	// UN = - 0 9 8 7
	db   8, 255, 255,  16,  15,   9,  21 	// BS UN UN p o i u
	db  13, 255,  39,  58,  12,  11,  10 	// RET UN ' colon l k j
	db 255, '`', ' ', '/', '.', ',',  13 	// GRAPH ` SP \ . , m
	db 255,'\\', ']', '[', '~', 127, 141 	// UN \ [ ] ~ DEL INS
	db   6, 138, 139,  15,   8,  14,  10 	// CAPS DELLINE HOME UP LEFT RIGHT DOWN
	db 255, 137, 136, 135, 134, 133, 132 	// UN F10 F9 F8 F7 F6 F5
	db 255, 128, 129, 130, 131, 255, 255   // UN F1 F2 F3 F4 UN UN

/*
// converts 2^n scancode into n
byte code_to_col(byte code) {
   byte col = 6;
   do {
      if(code & 1) break;
      col--;
      code = code >> 1;
   } while(col!=0);
   return col;
}
*/

CODE_TO_COL:
   LD   B,6
CODE_TO_COL0:
   RRA
   JR   C, CODE_TO_COL1
   DJNZ CODE_TO_COL0
CODE_TO_COL1:
	LD   A,B
	RET
