byte SCANCODES_SHIFT[84] = {
	255, 'Z', 'X', 'C', 'V', 'B', 'N',   // SHIFT z x c v b n
	255, 'A', 'S', 'D', 'F', 'G', 'H',   // SHIFT a s d f g h
    '\t','Q', 'W', 'E', 'R', 'T', 'Y',   // TAB q w e r t y
	 27, '!', '@', '#', '$', '%', '^',   // ESC 1 2 3 4 5 6
	255, '+', '_', ')', '(', '*', '&',   // UN = - 0 9 8 7
