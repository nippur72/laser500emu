byte SCANCODES_NORMAL[84] = {
	255, 'z', 'x', 'c', 'v', 'b', 'n',   // SHIFT z x c v b n
	255, 'a', 's', 'd', 'f', 'g', 'h',   // CTRL a s d f g h
	'\t','q', 'w', 'e', 'r', 't', 'y',   // TAB q w e r t y
