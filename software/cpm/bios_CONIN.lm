;***************************************************************************************
; CONIN (function 3)
; Wait until the keyboard is ready to provide a character, and return it in A.
;***************************************************************************************

include "laser500.lm"

; TODO consider IOBYTE

PUBLIC _CAPSLOCK         ; makes CAPSLOCK available to C (read_keyboard.c for flipping bit)
PUBLIC CAPSLOCK          ; makes CAPSLOCK available to CONOUT.asm
PUBLIC _CONIN            ; makes CONIN available to C

_CAPSLOCK EQU CAPSLOCK
_CONIN    EQU CAPSLOCK

; keyboard
CAPSLOCK: DEFB 0       ; caps lock state

CONIN:
    ld      a,64
    ret

/*
// mapped I/O pointers of keyboard rows 0-11
byte *keyboard_rows[12] = {
    0x68fe, 0x68fd, 0x68fb, 0x68f7, 0x68ef, 0x68df, 0x68bf, 0x687f,  // normal rows
    0x6bff, 0x6aff, 0x69ff, 0x68ff                                   // extended rows
};
*/

PUBLIC _KEYBOARD_ROWS

_KEYBOARD_ROWS EQU KEYBOARD_ROWS

KEYBOARD_ROWS:
    DEFW $68fe, $68fd, $68fb, $68f7, $68ef, $68df, $68bf, $687f   // normal rows
    DEFW $6bff, $6aff, $69ff, $68ff                               // extended rows

